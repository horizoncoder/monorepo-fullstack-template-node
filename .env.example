# Database
POSTGRES_DB=saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas

# Auth
COOKIE_SECRET=super-secret-cookie-key-change-in-production

# API base URL for frontend (local dev only; Docker uses same-origin via nginx proxy)
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Email
EMAIL_PROVIDER=maileroo
EMAIL_FROM=noreply@your-domain.maileroo.org
MAILEROO_API_KEY=your-maileroo-sending-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Telegram OAuth
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
